BES.Include=dap.conf

# ============================================================
# h5s3_handler — serves HDF5 files stored in S3 through the
# HDF5 ROS3 virtual file driver. The bucket's file list is
# cached as index.parquet under the data directory.
# ============================================================

BES.modules+=h5s3
BES.module.h5s3=@bes_modules_dir@/libh5s3_handler.so

# This handler serves files matching this pattern.
BES.Catalog.catalog.TypeMatch+=h5s3:.*\.(h5|he5|HDF5)$;

# --- S3 connection -----------------------------------------
# Bucket holding the HDF5 files.
H5S3.Bucket = h5s3

# Endpoint override for localstack or other S3-compatible services.
# Leave empty to use the real AWS endpoint.
H5S3.Endpoint = http://localhost:4566

# AWS region.
H5S3.Region = us-east-1

# Credentials (dummy values work with default localstack config).
H5S3.AccessKeyId = test
H5S3.SecretKey = test

# --- Index (Parquet) cache ---------------------------------
# Directory for index.parquet. Browsing this directory lists the
# bucket's HDF5 files from the cached index.
H5S3.IndexDir = @datadir@/hyrax/data/h5s3

# --- Out-of-process helpers --------------------------------
# The Arrow/Parquet stack bundles a different AWS SDK than the BES,
# so listing (AWS C++ SDK) and Parquet I/O run as separate helper
# executables rather than inside the BES process.
H5S3.ListBin  = @bes_modules_dir@/h5s3_list
H5S3.IndexBin = @bes_modules_dir@/h5s3_index
